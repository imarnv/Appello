# ─── Gemini Live ────────────────────────────────────────────────────────────
# The only strictly required key: without it the voice pipeline cannot start.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Kore

# ─── Server ─────────────────────────────────────────────────────────────────
# main.py's port. Azure App Service sets this itself, which is why deploy.sh
# deliberately skips pushing it as an app setting.
PORT=8000

# Comma-separated. Any https://*.vercel.app origin is allowed in addition.
ALLOWED_ORIGINS=http://localhost:3000,https://appello-ai.vercel.app

# ─── Postgres ───────────────────────────────────────────────────────────────
# Schema is created on first connect. See TENANCY.md before enabling RLS:
# a role with SUPERUSER or BYPASSRLS silently ignores every tenant policy.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
ADMIN_DATABASE_URL=postgresql://<owner>:<password>@<host>/<database>?sslmode=require
APP_DB_ROLE=appello_app
TENANT_RLS_ENFORCED=true
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_SLUG=default
# Lets a caller name its own tenant with X-Tenant-Id or ?tenant_id=, bypassing
# the bearer token. Turn OFF once tokens are verified for real.
ALLOW_TENANT_HEADER_OVERRIDE=true

# ─── Redis ──────────────────────────────────────────────────────────────────
# Session cache, customer pre-hydration, transcript pub/sub, embedding cache.
REDIS_URL=rediss://default:<password>@<host>:<port>

# ─── Qdrant — the knowledge-base vector store ───────────────────────────────
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>

# Embeddings for both ingestion and search. 1536-dim, cosine.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<resource>.services.ai.azure.com
AZURE_OPENAI_EMBEDDING_API_KEY=<key>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15

# Azure resource that hosts the chat/vision deployments used by the ingestion
# scripts. No endpoint is hardcoded in the source.
AZURE_OPENAI_RESOURCE=https://<resource>.cognitiveservices.azure.com
VISION_DEPLOYMENT=gpt-4.1-mini

# Vision deployment name read by ingest_manuals.py.
ECANTER_VISION_DEPLOYMENT=gpt-4.1-mini

# ─── Azure OpenAI Realtime pipeline (the non-Gemini path, /ws/voice) ────────
AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_DEPLOYMENT=gpt-realtime-2.1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Chat + speech-to-text deployments used by the REST surface.
AZURE_OPENAI_CHAT_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_CHAT_API_KEY=<key>
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_WHISPER_ENDPOINT=https://<resource>.cognitiveservices.azure.com/openai/deployments/whisper/audio/transcriptions?api-version=2024-06-01
AZURE_OPENAI_WHISPER_API_KEY=<key>

# ─── Sarvam TTS (Azure Realtime pipeline only) ──────────────────────────────
SARVAM_API_KEY=<key>
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=kabir

# ─── Exotel SIP telephony (optional — browser calls need none of this) ──────
EXOTEL_ACCOUNT_SID=<sid>
EXOTEL_API_KEY=<key>
EXOTEL_API_TOKEN=<token>
EXOTEL_CALLER_ID=<did>
EXOTEL_APP_FLOW_ID=<flow-id>
DEFAULT_SCENARIO=real_estate_lead

# ─── Adaptive voice and pace (support desks only) ───────────────────────────
GENDER_ADAPTIVE_VOICE=true
ADAPTIVE_PACE=true
# playbackRate resamples, so a wide range audibly shifts pitch. 0.9-1.1 keeps
# the agent sounding like one person.
PACE_MIN=0.9
PACE_MAX=1.1
MAX_VOICE_SWAPS=3
VOICE_SWAP_HISTORY_TURNS=12
