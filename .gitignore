# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Google Cloud service-account keys — never commit or deploy
rare-guide-*.json
*-service-account*.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/

# secrets and credentials — never commit, anywhere in the tree
*.env
.env*
!.env.example
*service-account*.json
*credentials*.json
*-key.json
*.pem
*.p12
*.pfx
id_rsa*

# runtime artefacts
*.log
*.zip
*.jsonl
qdrant_storage/

# local agent tooling — not part of the project
.claude/
CLAUDE.md
